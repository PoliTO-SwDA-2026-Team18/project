@startuml C4_Container_Egeria
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

title Egeria Platform - Container Diagram (Level 2)

Person(architect, "Information Architect", "Defines types, glossaries and governance")
Person(steward,   "Data Steward",          "Curates metadata quality and correctness")
Person(consumer,  "Asset Consumer",        "Searches and consults catalogued assets")
Person(admin,     "Platform Administrator","Configures and operates the platform")

System_Boundary(egeria, "Egeria Platform") {
    Container(mas, "Metadata Access Server", "Java 17, Spring Boot (OMAG Server)", "Hosts the Open Metadata Access Services (OMAS) and the Open Metadata Repository Services (OMRS). Central access point for metadata; exposes domain REST APIs and OMAS in/out event topics")
    Container(intd, "Integration Daemon", "Java 17, Spring Boot (OMAG Server)", "Hosts the Open Metadata Integration Services (OMIS) and their integration connectors. Synchronises metadata and lineage between Egeria and third-party technologies")
    Container(engine, "Engine Host", "Java 17, Spring Boot (OMAG Server)", "Hosts the Open Metadata Engine Services (OMES) and governance engines. Runs automated governance actions (e.g. surveys, remediation)")
    Container(view, "View Server", "Java 17, Spring Boot (OMAG Server)", "Hosts the Open Metadata View Services (OMVS). Provides REST APIs tailored to user interfaces")
    Container(proxy, "Repository Proxy", "Java 17, Spring Boot (OMAG Server)", "Cohort member that integrates a third-party metadata repository, mapping its APIs/events to Open Metadata Types")
    ContainerDb(metadataStore, "Metadata Repository", "Pluggable (in-memory / PostgreSQL / XTDB)", "Local metadata persistence. The implementation depends on the configured Repository Connector (in-memory default, PostgreSQL or XTDB for durable persistence)")
}

System_Ext(ui,            "Egeria React UI", "Web UI for exploring the open metadata ecosystem and configuring servers")
System_Ext(kafka,         "Apache Kafka",                     "Event backbone for cohort federation and asynchronous metadata exchange (Open Metadata Topics). Optional: in-memory fallback available")
System_Ext(thirdPartyRepo,"Third-party Metadata Repositories","Apache Atlas, IBM IGC, Collibra and others, federated via Repository Proxy")
System_Ext(dataSources,   "Data Sources",                     "Databases, data lakes, file systems, data warehouses — catalogues and lineage extracted via Integration Connectors")
System_Ext(externalTools, "Data Tools",                       "BI, ETL, data science platforms that produce or consume metadata")

Rel(architect, ui,   "Defines types, glossaries and models",                "HTTPS")
Rel(steward,   ui,   "Curates assets and handles exceptions",               "HTTPS")
Rel(consumer,  ui,   "Searches and consults assets",                        "HTTPS")
Rel(admin,     ui,   "Configures platform and logical servers",             "HTTPS")
Rel(ui,        view, "Invokes UI-oriented metadata operations",             "REST / HTTPS")
Rel(admin,     mas,  "Invokes admin endpoints directly (CLI / scripts)",    "REST / HTTPS")
Rel(view, mas, "Calls access services for UI experiences", "REST / HTTPS")
Rel(intd,   mas, "Pushes/pulls metadata via paired OMAS",        "REST / HTTPS")
Rel(engine, mas, "Reads metadata and writes governance results", "REST / HTTPS")
Rel(mas,   metadataStore, "Reads and writes metadata via Repository Connector", "JDBC / Java API")
Rel(mas,   kafka,         "Publishes and consumes OMRS / cohort topic events",  "Kafka protocol")
Rel(proxy, kafka,         "Exchanges cohort events with other members",         "Kafka protocol")
Rel(proxy,  thirdPartyRepo, "Federates metadata via Repository Proxy",                  "REST / native API")
Rel(intd,   dataSources,    "Extracts metadata and lineage via Integration Connectors", "JDBC / REST / native")
Rel(externalTools, intd,  "Reads catalogue metadata and pushes lineage / audit events", "REST / Kafka")

@enduml