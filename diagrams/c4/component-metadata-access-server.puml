@startuml C4_Component_MetadataAccessServer
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title Metadata Access Server (OMAS) - Component Diagram (Level 3)

Person(admin,   "Platform Administrator", "Configures and operates the platform")
Container(view,   "View Server",         "OMAG Server", "Hosts OMVS; provides REST APIs tailored to user interfaces")
Container(intd,   "Integration Daemon",  "OMAG Server", "Hosts OMIS and integration connectors; synchronises metadata with third-party technologies")
Container(engine, "Engine Host",         "OMAG Server", "Hosts OMES and governance engines; runs automated governance actions")
ContainerDb(dataRepo, "Metadata Repository", "PostgreSQL / XTDB / In-Memory", "Persistent store for metadata, audit, types")
Container(msgBus, "Apache Kafka", "Kafka", "Event backbone for cohort federation and asynchronous metadata exchange")

Container_Boundary(mas, "Metadata Access Server") {

    Component(userSec, "user-security", "Token-based auth", "token-manager: extracts auth headers, isolates per-thread credentials")

    Component(access, "access-services (OMAS)", "REST API layer", "ocf-metadata-management (OCF)\nomf-metadata-management (OMF)\ngaf-metadata-management (OGF)")

    Component(common, "common-services", "Shared utilities", "FFDC Service\nMetadata Security\nRepository Handler")

    Component(omrs, "repository-services (OMRS)", "Federation engine", "apis\narchive-utilities\nclient (Local & Enterprise)\nimplementation (peer-to-peer)\nspring (REST)")
}

Rel(admin,   userSec, "Sends auth headers", "HTTPS")
Rel(view,    userSec, "Sends auth headers", "HTTPS")
Rel(intd,    userSec, "Sends auth headers", "HTTPS")
Rel(engine,  userSec, "Sends auth headers", "HTTPS")

Rel(admin,   access, "Invokes admin endpoints directly", "REST / HTTPS")
Rel(view,    access, "Calls access services for UI experiences", "REST / HTTPS")
Rel(intd,    access, "Pushes / pulls metadata via paired OMAS", "REST / HTTPS")
Rel(engine,  access, "Reads metadata and writes governance results", "REST / HTTPS")

Rel(access, common, "Uses utilities & security checks")
Rel(access, omrs, "Reads / updates metadata")

Rel(common, omrs, "Translates repository-level exceptions")
Rel(userSec, common, "Provides authenticated principal")

Rel(omrs, dataRepo, "Reads and writes metadata via Repository Connector", "JDBC / Java API")
Rel(omrs, msgBus, "Publishes and consumes OMRS / cohort topic events", "Kafka protocol")

@enduml
