@startuml C4_Component_IntegrationDaemon
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title Integration Daemon - Component Diagram (Level 3)

System_Ext(extTool, "Data Tools", "BI, ETL, data science platforms that produce or consume metadata")
Container(mas, "Metadata Access Server", "OMAG Server", "Hosts OMAS, OMRS, common-services")
System_Ext(msgBus, "Apache Kafka", "Kafka", "Event backbone for asynchronous metadata change events")
System_Ext(dataSources, "Data Sources", "Databases, data lakes, file systems, data warehouses — catalogues and lineage extracted via Integration Connectors")

Container_Boundary(intd, "Integration Daemon") {

    Component(frameworks, "frameworks", "Pluggable interfaces", "Metadata: open type definitions\nConnector: access to real-world resources\nWatchdog: event monitoring & action triggers")

    Component(adapters, "adapters", "Concrete connectors", "Implement framework interfaces;\ntranslate between the tool's proprietary format\nand Egeria Open Metadata Types")
}

Rel(extTool, adapters, "Reads catalogue metadata and pushes lineage / audit events", "REST / Kafka")
Rel(adapters, frameworks, "Uses framework interfaces", "Java API")

Rel(adapters, mas, "Pushes metadata via paired OMAS", "REST / HTTPS")
Rel(mas, adapters, "Returns requested metadata", "REST / HTTPS")
Rel(mas, msgBus, "Publishes OMRS / cohort topic events", "Kafka protocol")
Rel(msgBus, mas, "Delivers metadata change events", "Kafka protocol")
Rel(adapters, msgBus, "Subscribes to metadata change events for sync", "Kafka protocol")
Rel(adapters, dataSources, "Extracts metadata and lineage via Integration Connectors", "JDBC / REST / native")

@enduml
