@startuml C4_Context_Egeria
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()

title Egeria Platform - Context Diagram (Level 1)

note as N1
  Scope: single OMAG Server Platform is shown; 
  cohort federation across multiple platforms 
  is out of scope at this level. 'TODO: ask if we need to have replicas
end note

' By definitions of the documentation
Person(architect, "Information Architect", "Domain expert designing the canonical metadata model")
Person(steward,   "Data Steward",          "Owner of asset quality and metadata correctness")
Person(consumer,  "Asset Consumer",        "Analyst, data engineer or product user looking for data")
Person(admin,     "Platform Administrators","DevOps / SRE responsible for Egeria operations")

System(egeria, "Egeria Platform", "Open Metadata & Governance platform: catalogues metadata, manages lineage, governance, federates third-party repositories")
' TODO: ask if this description is useful of is just noise bcause of the definition in other parts of the arch doc

System_Ext(dataSources,   "Data Sources", "Databases, data lakes, file systems, data warehouses, catalogues and lineage extracted via integration connectors")
System_Ext(externalTools, "Data Tools",   "BI, ETL, data science platforms and third-party catalogues that produce or consume metadata")
System_Ext(kafka,         "Apache Kafka/Message Bus", "Event backbone for asynchronous exchange of metadata change events (optional: in-memory fallback available)")
' TODO: ask if we can write here Kafka or we have to consider the default situation

Rel(architect, egeria, "Defines types, glossaries and governance models")
Rel(steward,   egeria, "Curates assets and handles exceptions")
Rel(consumer,  egeria, "Searches and consults assets")
Rel(admin,     egeria, "Configures platform and logical servers")

Rel(egeria, dataSources,   "Extracts metadata and lineage")
Rel(egeria, kafka,         "Publishes and consumes metadata change events")
Rel(externalTools, egeria, "Reads catalogue metadata and pushes lineage / audit events")
' TODO: arrow direction: egeria ussually starts the interaction with the internal integration connectors (do pull of datasources and tools)
' The external tools queries catalogue metadata (opposite direction)

@enduml
